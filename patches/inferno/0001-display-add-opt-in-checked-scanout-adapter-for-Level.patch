From c45f2f5d5fbdc2e707ebdf227177fd9baa4cd3f9 Mon Sep 17 00:00:00 2001
From: Level X GPU Development <levelx-gpu@localhost>
Date: Wed, 14 Oct 2026 21:26:17 +0300
Subject: [PATCH 1/2] display: add opt-in checked scanout adapter for Level X

---
 hw/display/apple_displaypipe_v4.c |  88 ++++++++++++++++++--
 hw/display/levelx_scanout.c       | 128 ++++++++++++++++++++++++++++++
 hw/display/levelx_scanout.h       |  79 ++++++++++++++++++
 hw/display/meson.build            |   2 +-
 4 files changed, 291 insertions(+), 6 deletions(-)
 create mode 100644 hw/display/levelx_scanout.c
 create mode 100644 hw/display/levelx_scanout.h

diff --git a/hw/display/apple_displaypipe_v4.c b/hw/display/apple_displaypipe_v4.c
index 8e77db8..492a5d7 100644
--- a/hw/display/apple_displaypipe_v4.c
+++ b/hw/display/apple_displaypipe_v4.c
@@ -29,6 +29,7 @@
 #include "qemu/log.h"
 #include "system/dma.h"
 #include "ui/console.h"
+#include "levelx_scanout.h"
 
 #ifdef CONFIG_PIXMAN
 #include "pixman.h"
@@ -172,6 +173,7 @@ struct AppleDisplayPipeV4State {
     qemu_irq irqs[9];
     uint32_t int_status;
     uint32_t int_enable;
+    bool levelx_checked_scanout;
     ADPV4GenPipe genpipe[ADP_V4_GP_COUNT];
     ADPV4BlendUnitState blend_unit;
     QemuConsole *console;
@@ -312,7 +314,66 @@ static pixman_format_code_t adp_v4_gp_fmt_to_pixman(ADPV4GenPipe *genpipe)
     return 0;
 }
 
-static void adp_v4_gp_read(ADPV4GenPipe *genpipe, AddressSpace *dma_as)
+/* Level X adapter: host safety checks only; not an AGX device protocol. */
+static void *adp_v4_levelx_alloc(void *opaque, size_t size)
+{
+    return g_try_malloc(size);
+}
+
+static void adp_v4_levelx_free(void *opaque, void *ptr)
+{
+    g_free(ptr);
+}
+
+static int adp_v4_levelx_dma_read(void *opaque, uint64_t addr, void *dst,
+                                 size_t size)
+{
+    return dma_memory_read(opaque, addr, dst, size, MEMTXATTRS_UNSPECIFIED) ==
+                   MEMTX_OK ? 0 : -1;
+}
+
+static void adp_v4_gp_read_checked(ADPV4GenPipe *genpipe, AddressSpace *dma_as)
+{
+    LXGSnapshot snapshot = { 0 };
+    LXGLayout layout = {
+        .iova = genpipe->state.data_start,
+        .width = genpipe->state.src_width,
+        .height = genpipe->state.src_height,
+        .stride = genpipe->state.stride,
+        .format = LXG_RAW32,
+    };
+    const LXGLimits limits = { UINT32_MAX, LXG_DEFAULT_MAX_BYTES };
+    const LXGAllocator allocator = {
+        .alloc = adp_v4_levelx_alloc,
+        .release = adp_v4_levelx_free,
+    };
+    LXGStatus status;
+
+    if (!adp_v4_gp_fmt_to_pixman(genpipe)) {
+        return;
+    }
+    /* DATA_END semantics are not established; do not guess an inclusive or
+     * exclusive fence. Bounds come from layout, a host cap, and QEMU DART. */
+    status = lxg_snapshot_read(&snapshot, &layout, &limits, &allocator,
+                                adp_v4_levelx_dma_read, dma_as);
+    if (status != LXG_OK) {
+        qemu_log_mask(LOG_GUEST_ERROR, "levelx: gp%d scanout rejected: %s\n",
+                      genpipe->index, lxg_status_string(status));
+        return;
+    }
+
+    /* Pixman borrows buf; release its cached image before replacing buf. */
+    qemu_pixman_image_unref(genpipe->state.image);
+    genpipe->state.image = NULL;
+    g_free(genpipe->state.buf);
+    genpipe->state.buf = snapshot.data;
+    genpipe->state.buf_len = (uint32_t)snapshot.size;
+    genpipe->state.buf_capacity = (uint32_t)snapshot.size;
+    /* Ownership transferred to existing GP state/reset/VMState code. */
+}
+
+static void adp_v4_gp_read(ADPV4GenPipe *genpipe, AddressSpace *dma_as,
+                          bool checked)
 {
     uint32_t len;
 
@@ -330,6 +391,11 @@ static void adp_v4_gp_read(ADPV4GenPipe *genpipe, AddressSpace *dma_as)
              genpipe->state.src_width, genpipe->state.src_height);
     ADP_INFO("gp%d: stride is %d.", genpipe->index, genpipe->state.stride);
 
+    if (checked) {
+        adp_v4_gp_read_checked(genpipe, dma_as);
+        return;
+    }
+
     len = genpipe->state.src_height * genpipe->state.stride;
     if (genpipe->state.buf_capacity < len) {
         g_free(genpipe->state.buf);
@@ -859,6 +925,8 @@ static void adp_v4_realize(DeviceState *dev, Error **errp)
 static const Property adp_v4_props[] = {
     DEFINE_PROP_UINT32("width", AppleDisplayPipeV4State, width, 0),
     DEFINE_PROP_UINT32("height", AppleDisplayPipeV4State, height, 0),
+    DEFINE_PROP_BOOL("levelx-checked-scanout", AppleDisplayPipeV4State,
+                     levelx_checked_scanout, false),
 };
 
 static void adp_v4_class_init(ObjectClass *klass, const void *data)
@@ -891,7 +959,8 @@ type_init(adp_v4_register_types);
 
 // TODO: handle source/dest position, etc.
 static void adp_v4_gp_draw(ADPV4GenPipe *genpipe, AddressSpace *dma_as,
-                           pixman_image_t *disp_image, QemuConsole *console)
+                           pixman_image_t *disp_image, QemuConsole *console,
+                           bool checked)
 {
     pixman_format_code_t fmt;
     pixman_image_t *image;
@@ -904,7 +973,7 @@ static void adp_v4_gp_draw(ADPV4GenPipe *genpipe, AddressSpace *dma_as,
     }
 
     qemu_mutex_lock(&genpipe->lock);
-    adp_v4_gp_read(genpipe, dma_as);
+    adp_v4_gp_read(genpipe, dma_as, checked);
     qemu_mutex_unlock(&genpipe->lock);
 
     if (genpipe->state.buf_len != 0) {
@@ -916,6 +985,13 @@ static void adp_v4_gp_draw(ADPV4GenPipe *genpipe, AddressSpace *dma_as,
                 (uint32_t *)genpipe->state.buf, genpipe->state.stride);
         }
 
+        if (checked && !image) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "levelx: gp%d Pixman image allocation failed\n",
+                          genpipe->index);
+            return;
+        }
+
         pixman_image_composite(PIXMAN_OP_SRC, image, NULL, disp_image, 0, 0, 0,
                                0, 0, 0, genpipe->state.dest_width,
                                genpipe->state.dest_height);
@@ -932,8 +1008,10 @@ static void adp_v4_update_disp_bh(void *opaque)
 
     disp_image = qemu_console_surface(adp->console)->image;
 
-    adp_v4_gp_draw(&adp->genpipe[0], &adp->dma_as, disp_image, adp->console);
-    adp_v4_gp_draw(&adp->genpipe[1], &adp->dma_as, disp_image, adp->console);
+    adp_v4_gp_draw(&adp->genpipe[0], &adp->dma_as, disp_image, adp->console,
+                    adp->levelx_checked_scanout);
+    adp_v4_gp_draw(&adp->genpipe[1], &adp->dma_as, disp_image, adp->console,
+                    adp->levelx_checked_scanout);
 
     qatomic_or(&adp->int_status, R_CONTROL_INT_FRAME_PROCESSED_MASK);
     adp_v4_update_irqs(adp);
diff --git a/hw/display/levelx_scanout.c b/hw/display/levelx_scanout.c
new file mode 100644
index 0000000..40e7770
--- /dev/null
+++ b/hw/display/levelx_scanout.c
@@ -0,0 +1,128 @@
+#include "qemu/osdep.h"
+/* SPDX-License-Identifier: MIT */
+#include "levelx_scanout.h"
+#include <limits.h>
+#include <string.h>
+
+LXGStatus lxg_validate(const LXGLayout *layout, const LXGLimits *limits,
+                       size_t *required)
+{
+    uint64_t bytes;
+    if (required) {
+        *required = 0;
+    }
+    if (!layout || !limits || !required || !limits->max_bytes) {
+        return LXG_INVALID;
+    }
+    if (layout->format != LXG_RAW32) {
+        return LXG_UNSUPPORTED;
+    }
+    if (!layout->width || !layout->height ||
+        layout->width > LXG_MAX_DIMENSION ||
+        layout->height > LXG_MAX_DIMENSION) {
+        return LXG_BOUNDS;
+    }
+    /* Pixman consumes signed-int dimensions and a four-byte-aligned stride. */
+    if ((layout->stride & 3u) || layout->stride > INT_MAX ||
+        (uint64_t)layout->stride < (uint64_t)layout->width * 4u) {
+        return LXG_BOUNDS;
+    }
+    bytes = (uint64_t)layout->stride * layout->height;
+    if (bytes > SIZE_MAX || bytes > limits->max_bytes ||
+        layout->iova > limits->address_max ||
+        bytes - 1u > limits->address_max - layout->iova) {
+        return LXG_BOUNDS;
+    }
+    *required = (size_t)bytes;
+    return LXG_OK;
+}
+
+void lxg_snapshot_reset(LXGSnapshot *snapshot)
+{
+    if (!snapshot) {
+        return;
+    }
+    if (snapshot->data) {
+        snapshot->allocator.release(snapshot->allocator.opaque, snapshot->data);
+    }
+    memset(snapshot, 0, sizeof(*snapshot));
+}
+
+LXGStatus lxg_snapshot_read(LXGSnapshot *snapshot, const LXGLayout *layout,
+                            const LXGLimits *limits,
+                            const LXGAllocator *allocator,
+                            LXGRead read, void *opaque)
+{
+    LXGSnapshot next = {0};
+    LXGStatus status;
+    size_t offset = 0;
+    if (!snapshot || !allocator || !allocator->alloc ||
+        !allocator->release || !read) {
+        return LXG_INVALID;
+    }
+    status = lxg_validate(layout, limits, &next.size);
+    if (status != LXG_OK) {
+        return status;
+    }
+    next.layout = *layout;
+    next.allocator = *allocator;
+    next.data = allocator->alloc(allocator->opaque, next.size);
+    if (!next.data) {
+        return LXG_NO_MEMORY;
+    }
+    while (offset < next.size) {
+        uint64_t addr = next.layout.iova + offset;
+        size_t chunk = 4096u - (size_t)(addr & 4095u);
+        if (chunk > next.size - offset) {
+            chunk = next.size - offset;
+        }
+        if (read(opaque, addr, next.data + offset, chunk) != 0) {
+            lxg_snapshot_reset(&next);
+            return LXG_DMA_ERROR;
+        }
+        offset += chunk;
+    }
+    lxg_snapshot_reset(snapshot);
+    *snapshot = next;
+    return LXG_OK;
+}
+
+LXGStatus lxg_fill_rect(LXGSnapshot *snapshot, uint32_t x, uint32_t y,
+                        uint32_t width, uint32_t height, const uint8_t pixel[4])
+{
+    size_t required;
+    LXGLimits limits = {UINT64_MAX, SIZE_MAX};
+    uint8_t value[4];
+    if (!snapshot || !snapshot->data || !pixel) {
+        return LXG_INVALID;
+    }
+    if (lxg_validate(&snapshot->layout, &limits, &required) != LXG_OK ||
+        required != snapshot->size || x > snapshot->layout.width ||
+        y > snapshot->layout.height || width > snapshot->layout.width - x ||
+        height > snapshot->layout.height - y) {
+        return LXG_BOUNDS;
+    }
+    /* pixel may alias the destination. Capture it before the first write. */
+    memcpy(value, pixel, sizeof(value));
+    for (uint32_t row = 0; row < height; ++row) {
+        uint8_t *dst = snapshot->data + (size_t)(y + row) * snapshot->layout.stride
+                       + (size_t)x * 4u;
+        for (uint32_t col = 0; col < width; ++col) {
+            memcpy(dst + (size_t)col * 4u, value, sizeof(value));
+        }
+    }
+    return LXG_OK;
+}
+
+const char *lxg_status_string(LXGStatus status)
+{
+    switch (status) {
+    case LXG_OK: return "ok";
+    case LXG_INVALID: return "invalid argument";
+    case LXG_UNSUPPORTED: return "unsupported format";
+    case LXG_BOUNDS: return "layout/address outside limits";
+    case LXG_NO_MEMORY: return "allocation failed";
+    case LXG_DMA_ERROR: return "DMA read failed";
+    default: return "unknown status";
+    }
+}
diff --git a/hw/display/levelx_scanout.h b/hw/display/levelx_scanout.h
new file mode 100644
index 0000000..2155df3
--- /dev/null
+++ b/hw/display/levelx_scanout.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef LEVELX_SCANOUT_H
+#define LEVELX_SCANOUT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define LXG_ABI_VERSION 1u
+#define LXG_DEFAULT_MAX_BYTES (64u * 1024u * 1024u)
+#define LXG_MAX_DIMENSION 16384u
+
+/* Host-side API only. These values are NOT Apple register/opcode values. */
+typedef enum {
+    LXG_OK = 0,
+    LXG_INVALID,
+    LXG_UNSUPPORTED,
+    LXG_BOUNDS,
+    LXG_NO_MEMORY,
+    LXG_DMA_ERROR
+} LXGStatus;
+
+typedef enum {
+    LXG_RAW32 = 1 /* Four opaque bytes/pixel; no conversion or compression. */
+} LXGFormat;
+
+typedef struct {
+    uint64_t iova;
+    uint32_t width, height, stride;
+    LXGFormat format;
+} LXGLayout;
+
+typedef struct {
+    uint64_t address_max; /* Inclusive maximum DMA address, supplied by adapter. */
+    size_t max_bytes;     /* Maximum per-frame allocation, nonzero. */
+} LXGLimits;
+
+typedef struct {
+    void *opaque;
+    void *(*alloc)(void *opaque, size_t size);
+    void (*release)(void *opaque, void *ptr);
+} LXGAllocator;
+
+/* Return zero only if all requested bytes were read. No retained pointers. */
+typedef int (*LXGRead)(void *opaque, uint64_t iova, void *dst, size_t size);
+
+/* Zero-initialize. Treat fields as read-only; serialize calls externally.
+ * No worker threads, guest queues, implicit identity mappings or IRQs. */
+typedef struct {
+    uint8_t *data;
+    size_t size;
+    LXGLayout layout;
+    LXGAllocator allocator;
+} LXGSnapshot;
+
+LXGStatus lxg_validate(const LXGLayout *layout, const LXGLimits *limits,
+                       size_t *required);
+
+/* Transactional replacement: on failure the previous snapshot is unchanged.
+ * Caller must not present it as the failed frame. Peak storage is the previous
+ * snapshot size plus the new cap (at most 2*cap when limits are unchanged).
+ * Callback chunks stop at 4 KiB boundaries (transfer granularity, NOT a DART
+ * page-size assertion); the callback owns translation and access checks.
+ * The guest must be quiescent or provide synchronization before this call. */
+LXGStatus lxg_snapshot_read(LXGSnapshot *snapshot, const LXGLayout *layout,
+                            const LXGLimits *limits,
+                            const LXGAllocator *allocator,
+                            LXGRead read, void *opaque);
+
+/* Idempotent reset/destroy. All borrowed data pointers become invalid. */
+void lxg_snapshot_reset(LXGSnapshot *snapshot);
+
+/* Minimal software operation, for host-owned snapshots only. Writes the four
+ * supplied bytes literally; preserves row padding and all other pixels.
+ * This is NOT a guest command, Metal operation, or shader implementation. */
+LXGStatus lxg_fill_rect(LXGSnapshot *snapshot, uint32_t x, uint32_t y,
+                        uint32_t width, uint32_t height, const uint8_t pixel[4]);
+
+const char *lxg_status_string(LXGStatus status);
+#endif
